# Copy this file to .env and fill in the values. Docker Compose reads .env
# automatically. Every variable here also has a sensible default in
# docker-compose.yml, so for local dev you really only need the two AI keys
# (plus an email + session secret if you leave magic-link auth enabled).

# ---------------------------------------------------------------------------
# Required: AI providers
# ---------------------------------------------------------------------------

# Powers chat (default model: claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-...

# Powers vector embeddings (default model: text-embedding-3-small, 1536-dim).
OPENAI_API_KEY=sk-...

# Optional overrides. Changing OPENAI_EMBED_MODEL changes vector dimensions
# and will auto-drop + re-index the Qdrant collection on next backend start.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Auth (magic-link via Resend)
# ---------------------------------------------------------------------------

# Comma-separated allowlist of emails that may sign in.
ALLOWED_EMAIL=you@example.com

# Long random string used to sign session cookies. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=replace-with-a-long-random-string

# Resend API key. Sign up at https://resend.com — free tier covers personal use.
RESEND_API_KEY=re_...

# Verified sender address. Use the Resend sandbox sender for local dev, or a
# domain you've verified in Resend for production.
# RESEND_FROM=onboarding@resend.dev

# Public URL of the app. Used to build the magic-link target in emails.
# APP_BASE_URL=http://localhost:3000

# Set true in production (HTTPS); leave false for local dev (HTTP).
# COOKIE_SECURE=false

# Set true to skip the magic-link flow entirely (handy for API smoke tests).
# AUTH_DISABLED=false

# ---------------------------------------------------------------------------
# Photo storage (Cloudflare R2)
# ---------------------------------------------------------------------------
# Required only if you want to attach photos to events. Without these, the
# rest of the app works; photo upload endpoints will return errors.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------------------------------------------------------------------------
# Database (optional overrides)
# ---------------------------------------------------------------------------
# By default docker-compose runs Mongo and Qdrant locally. To point dev at
# a remote Atlas cluster, set MONGO_URL. Parking the Atlas string under a
# DIFFERENT name (e.g. ATLAS_MONGO_URL) is a deliberate way to keep local
# dev pointed at the in-cluster container — see CLAUDE.md > Local dev vs.
# production.

# MONGO_URL=mongodb+srv://...
# ATLAS_MONGO_URL=mongodb+srv://...
# QDRANT_URL=http://qdrant:6333

# Comma-separated origins allowed by FastAPI's CORS middleware. Defaults
# cover the docker compose frontend (:3000) and the Vite dev server (:5173).
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
