# Point the app at a backend. Omit to use production (https://hindsite.app,
# from app.json > expo.extra.apiBaseUrl).
#
# For local dev against `docker compose up` on your Mac, use your machine's
# LAN IP (NOT localhost — that resolves to the phone/simulator itself). Find it
# with `ipconfig getifaddr en0`. The :8000 backend serves /api directly.
#
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000
