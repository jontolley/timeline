{
  "expo": {
    "name": "Hindsite",
    "slug": "hindsite",
    "scheme": "hindsite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "app.hindsite.mobile"
    },
    "android": {
      "package": "app.hindsite.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF1F5",
          "dark": {
            "backgroundColor": "#121820"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hindsite needs access to your photos so you can attach them to events.",
          "cameraPermission": false,
          "microphonePermission": "Hindsite uses the microphone to record voice notes for your moments."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-font",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10,
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true
            }
          }
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-maps",
      [
        "expo-audio",
        {
          "microphonePermission": "Hindsite uses the microphone to record voice notes for your moments."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://hindsite.app"
    }
  }
}
