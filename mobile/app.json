{
  "expo": {
    "name": "Hindsite",
    "slug": "hindsite",
    "scheme": "hindsite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#eef1f8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hindsite.mobile"
    },
    "android": {
      "package": "app.hindsite.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "https://hindsite.app"
    }
  }
}
